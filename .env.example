# Database Configuration for Serhafen US (serhafen_common/us schema)
DB_BU1_US_HOST=localhost
DB_BU1_US_PORT=5432
DB_BU1_US_USERNAME=postgres
DB_BU1_US_PASSWORD=password
DB_BU1_US_DATABASE=serhafen_common
DB_BU1_US_SCHEMA=us


# Database Pool Configuration
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_POOL_IDLE=10000

# Razorpay (Test Mode) - get these from Razorpay Dashboard > Settings > API Keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
# From Razorpay Dashboard > Settings > Webhooks, after registering a webhook URL
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
